# Presto diffuser shell - WEDGE CUP (isolated, get this clean first; border re-added after).
# Flat-top + steep-back walls, 3mm, hollow, OPEN toward the Presto (cavity clears the inner-
# face electronics), seated on PrestoSolid. Needs presto_build run first. OCC-safe.
import FreeCAD as App, FreeCADGui as Gui, Part, math
from FreeCAD import Vector as V

LEAN, STRUT, T = 0.0, 21.8, 2.0
LB, LS, RB = 94.6, 68.4, 10.6
WIDTH = 92.22
half = T / 2.0
FTOP  = 22.0
WALL  = 3.0
OVER  = 3.0
CLEAR = 0.18
BIG = 400.0

def rot(v, a):
    c, s = math.cos(a), math.sin(a); return V(c*v.x - s*v.y, s*v.x + c*v.y, 0)
th = math.radians(90 + LEAN); hb = V(math.cos(th), math.sin(th), 0)
B0 = V(0,0,0); B1 = B0 + hb*LB
nb = V(-math.sin(th), math.cos(th), 0); C0 = B1 - nb*RB
turn = math.radians((90 + LEAN) - (-STRUT))
E = C0 + rot(B1 - C0, -turn)
hs = V(math.cos(math.radians(-STRUT)), math.sin(math.radians(-STRUT)), 0); S = E + hs*LS
nbo = (B1 - C0).normalize(); nso = (E - C0).normalize()
def band_full(h): return dict(OB0=B0+nbo*h, OB1=B1+nbo*h, RB0=B0-nbo*h, RB1=B1-nbo*h,
                              OE=E+nso*h, OS=S+nso*h, RE=E-nso*h, RS=S-nso*h)
Rr = math.radians(STRUT)
def rm(p):
    c, s = math.cos(Rr), math.sin(Rr); return V(c*p.x - s*p.y, -(s*p.x + c*p.y), 0)
_t = [rm(p) for p in band_full(half).values()]
OFFX = min(p.x for p in _t); OFFY = min(p.y for p in _t)
def TT(p): q = rm(p); return V(q.x-OFFX, q.y-OFFY, 0)
def M(p): return V(0.0, p.x, p.y)

p = {k: TT(v) for k, v in band_full(half).items()}
def uvec(a,b): d=(b-a); d.normalize(); return d
def prism(pts2d, xlen, xoff):
    w = Part.makePolygon([M(q) for q in pts2d] + [M(pts2d[0])])
    s = Part.Face(w).extrude(V(xlen,0,0)); s.translate(V(xoff,0,0)); return s

doc = App.ActiveDocument
Pobj = doc.getObject("PrestoSolid") if doc else None
if Pobj is None or getattr(Pobj,"Shape",None) is None or Pobj.Shape.isNull():
    raise SystemExit("No PrestoSolid - run presto_build first")
P = Pobj.Shape
if doc.getObject("PrestoShell"): doc.removeObject("PrestoShell")

# --- wedge triangle (flat top + steep back + mouth chord) ---
ds = uvec(p['OB1'], p['OB0']); db = uvec(p['OE'], p['OS'])
Rim_top = p['OB0'] + ds*OVER
Rim_tip = p['OS']  + db*OVER
FT = V(Rim_top.x + FTOP, Rim_top.y, 0)
tri = [Rim_top, FT, Rim_tip]
SW = WIDTH + 2*OVER
wedge = prism(tri, SW, -OVER)

# --- hollow to 3mm walls with makeThickness, removing ONLY the mouth face (toward the void) ---
ctr = V((Rim_top.x+FT.x+Rim_tip.x)/3.0, (Rim_top.y+FT.y+Rim_tip.y)/3.0, 0)
mdir = uvec(Rim_tip, Rim_top); mperp = V(-mdir.y, mdir.x, 0)
mmid = V((Rim_top.x+Rim_tip.x)/2.0, (Rim_top.y+Rim_tip.y)/2.0, 0)
if (mmid + mperp - ctr).Length < (mmid - ctr).Length: mperp = V(-mperp.x, -mperp.y, 0)
mo3d = V(0.0, mperp.x, mperp.y)                      # toward the void
mouth_face = None; best = -1e9
for f in wedge.Faces:
    try: n = f.normalAt(*f.Surface.parameter(f.CenterOfMass))
    except Exception: continue
    if abs(n.x) > 0.5: continue                      # skip the X-end (side) caps
    d = n.dot(mo3d)
    if d > best: best = d; mouth_face = f
shell = wedge.makeThickness([mouth_face], -WALL, 0.01)   # walls on all faces but the mouth
App.Console.PrintMessage(f"cup vol={shell.Volume:.0f}  (mouth face n.void={best:.2f})\n")

# seat on the real Presto (rounded corners) with clearance - makeOffsetShape (OCC-safe)
Pseat = P.makeOffsetShape(CLEAR, 0.01)
shell = shell.cut(Pseat)
App.Console.PrintMessage(f"after seat vol={shell.Volume:.0f}\n")

obj = doc.addObject("Part::Feature", "PrestoShell"); obj.Shape = shell
try: obj.ViewObject.Transparency=25; obj.ViewObject.ShapeColor=(0.6,0.8,1.0)
except Exception: pass
doc.recompute()
App.Console.PrintMessage(f"PrestoShell (wedge cup) vol={shell.Volume:.0f}\n")
Gui.activeDocument().activeView().viewAxonometric(); Gui.SendMsgToActiveView("ViewFit")
